{
  "manifest_version": 3,
  "name": "NOCAP - Fake News Detector",
  "version": "1.3",
  "description": "On-device AI credibility indicator for YouTube videos.",
  "action": {
    "default_title": "Open NOCAP",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/content.ts-BqTi6Q89.js"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "resources": [
        "shadow-ui.js",
        "content.css",
        "assets/content.ts-BqTi6Q89.js"
      ],
      "use_dynamic_url": false
    }
  ],
  "permissions": [
    "storage"
  ]
}
